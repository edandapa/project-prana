# --- Clasp / Google Apps Script Specifics ---
# This file links your local folder to your specific Google Script. 
# Keeping it private prevents others from overwriting your cloud code.
.clasp.json

# --- Dependencies ---
# These are the libraries clasp needs to run. 
# They are massive and can be reinstalled anytime with 'npm install'.
node_modules/

# --- Environment & Secrets ---
# Even though you use Script Properties, you might use a .env file 
# for local testing. Never commit this.
.env
auth.json
creds.json
*.key

# --- System & IDE Junk ---
# Mac system files
.DS_Store
# Windows system files
thumbs.db
# VS Code specific settings (Optional)
.vscode/

# --- Logs ---
# Any local execution logs or error reports
npm-debug.log*
yarn-debug.log*
yarn-error.log*